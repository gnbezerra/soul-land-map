// Markdown lint, for `npm run lint:md`, CI and the VS Code markdownlint extension (which reads this file too).
// Every rule is on with its default settings, except the ones below.
{
  "config": {
    "default": true,
    // Prose is wrapped by hand at about 110 columns; 120 catches what went past that without forcing a
    // rewrap of every paragraph. A table row or a code line cannot be wrapped, so they are not checked.
    "MD013": { "line_length": 120, "tables": false, "code_blocks": false }
  },
  // Every Markdown file in the repo except third-party code, the npm packages and the owner's private notes
  // (CLAUDE.local.md is not committed).
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "vendor/**", "maps/**", "CLAUDE.local.md"]
}
